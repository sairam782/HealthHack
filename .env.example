# The existing local .env is loaded by npm start. Never commit actual keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Bedrock needs an API key or AWS identity plus model access; Transcribe needs an AWS identity.
# AI_PROVIDER=bedrock
# Optional independent second opinion; emergency/clinical rules bypass both models.
# AI_ROUTING_MODE=ensemble
# AI_SECONDARY_PROVIDER=groq
# AI_SECONDARY_MODEL=openai/gpt-oss-120b
# Groq uses the server-side GROQ_API_KEY. To use the teammate model instead:
# AI_SECONDARY_PROVIDER=setfit
# SETFIT_ENDPOINT_URL=https://your-private-inference-endpoint.example
# SETFIT_API_TOKEN=
# A Hugging Face repository URL alone is not an inference endpoint.
# VOICE_INPUT_PROVIDER=aws
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# A short-term Bedrock key can enable classification without AWS access keys.
# AWS_BEARER_TOKEN_BEDROCK=
# This key does not authenticate Transcribe. Keep VOICE_INPUT_PROVIDER=browser
# until AWS temporary credentials or a runtime role are configured for speech input.
# For local SSO/temporary credentials, the SDK also supports AWS_PROFILE.
# On AWS hosting use an instance/task role; do not embed AWS credentials in frontend code.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Required on Vercel/AWS. Use a pooled PostgreSQL URL supplied by your database provider.
DATABASE_URL=
# At least 10 characters. All seeded demo accounts initially use this password.
DEMO_PASSWORD=

# Optional locally; required for reliable relayed video on public hosting.
# Comma-separated coturn URLs. Prefer a TLS relay on port 443 for restricted networks.
WEBRTC_TURN_URLS=
# Coturn REST authentication shared secret. Stays server-side; participants receive temporary credentials.
WEBRTC_TURN_SHARED_SECRET=
# Explicit hackathon demo only: permits direct WebRTC with public STUN, without a TURN relay.
# Prefer both devices on the same Wi-Fi; restrictive networks may still block calls.
# WEBRTC_DEMO_MODE=true
